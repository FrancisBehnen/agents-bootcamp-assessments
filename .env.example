# ============================================================
# Agents Bootcamp — environment variables
# ============================================================
# 1. Copy this file:        cp .env.example .env
# 2. Fill in the values     (you received these from the trainers)
# 3. Verify your setup:      python check_setup.py
#
# The .env file is git-ignored, so your keys never end up on GitHub.
# NEVER hardcode keys in your Python files — the #1 security mistake in
# real projects.
# ============================================================

# --- The AI Service Router ----------------------------------
# We do NOT call OpenAI directly this week. All model calls go through
# Coolblue's AI Service Router: an OpenAI-compatible endpoint with failover,
# shared quota and central auth, run by the Virtual Agents Platform team.
# You need THREE things from the trainers (#virtual-agents-platform):

# 1. Your API key (provisioned by VAP — never paste it into chat or code)
AI_SERVICE_ROUTER_API_KEY=

# 2. The clientName your bootcamp/team is registered under (e.g. agents_bootcamp)
AI_SERVICE_ROUTER_CLIENT=

# 3. The router URL. Default is the TEST environment — leave as-is for the bootcamp.
AI_SERVICE_ROUTER_BASE_URL=https://ai-service-router.self-service-gen-ai.aws-tst.cool.blue/router

# --- The model you will use ---------------------------------
# Must be a fully-pinned model ID the router supports. You can swap this any
# time without changing code — the harness reads this variable.
# Other options: gpt-4.1-2025-04-14 (smarter), gpt-5-mini-2025-08-07.
BOOTCAMP_MODEL=gpt-4.1-mini-2025-04-14

# --- LangSmith: observability -------------------------------
# You already used LangSmith on the Observability & Evaluation day.
# With these set, EVERY workflow and agent you build this week automatically
# shows up as a trace at https://smith.langchain.com — no extra code needed.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Use your own name so you can find your traces among everyone else's:
LANGSMITH_PROJECT=agents-bootcamp-YOURNAME
